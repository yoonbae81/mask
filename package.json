{
  "name": "mask",
  "version": "0.1.0",
  "description": "Sensitive data de-identification LLM reverse proxy",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts' 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm run test",
    "inspect": "node src/tools/inspect.ts",
    "smoke:openclaw-glm": "node scripts/smoke-openclaw-glm.mjs"
  },
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "pino": "^9.0.0",
    "undici": "^7.0.0",
    "yaml": "^2.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "fast-check": "^3.0.0",
    "json5": "^2.2.3",
    "typescript": "^5.6.0"
  }
}
