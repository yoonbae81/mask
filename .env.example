# ==============================================================================
# Mask Environment Variables Configuration (.env.sample)
# 복사하여 .env 파일을 생성한 뒤 필요에 맞게 값을 수정하여 사용하세요:
#   cp .env.sample .env
# ==============================================================================

# ── 필수 설정 ─────────────────────────────────────────────────────────────────
# 민감어 정의 YAML 파일 경로 (단일 파일 경로 또는 *.yaml 파일들이 있는 디렉터리)
# 상대 경로 입력 시 프로세스 실행 디렉터리(CWD) 기준으로 자동 변환됩니다.
MASK_TERMS_FILE=config/terms.yaml

# 업스트림 Provider 정의 YAML 파일 경로
MASK_PROVIDERS_FILE=config/providers.yaml


# ── 프록시 서버 바인딩 ─────────────────────────────────────────────────────────
# 로컬 전용 리버스 프록시이므로 127.0.0.1 유지를 권장합니다.
MASK_HOST=127.0.0.1

# 프록시 포트 (OpenClaw, VS Code 확장, Claude CLI 등의 ANTHROPIC_BASE_URL 삽입 대상)
MASK_PORT=8787


# ── 동작 및 보안 제어 ──────────────────────────────────────────────────────────
# 응답 스트리밍 모드:
#   rolling : TransformStream 기반 실시간 경계 인식 토큰 복원 (기본값, 권장)
#   buffer  : 응답 전체를 버퍼링한 뒤 일괄 복원하여 전송 (디버깅/폴백용)
MASK_STREAMING_MODE=rolling

# 탐지/치환 실패 시 업스트림 요청 차단 여부 (true: 유출 방지를 위한 fail-closed)
MASK_FAIL_CLOSED=true

# 송신 직전 직렬화 본문 재스캔 가드 (on | off)
# 토큰화 누락이나 워커 버그로 인한 유출을 최종 차단하므로 항상 'on' 유지를 강력 권장합니다.
MASK_GUARD=on

# 1회성 마스킹 우회 (on | off, 기본 off)
# 요청 텍스트에서 \등록용어 처럼 백슬래시를 붙이면 그 occurrence 만 마스킹하지 않고
# 원문 그대로 업스트림으로 보낸다. 보안 예외 기능이므로 필요할 때만 on.
MASK_TERM_ESCAPE=off

# 치환 토큰 포맷 ({type}: 분류명, {n}: 분류별 순번)
MASK_TOKEN_FORMAT=<{type}_{n}>

# 업스트림 요청 타임아웃 (초 단위, 기본 600초 = 10분)
MASK_UPSTREAM_TIMEOUT=600

# 요청 최대 본문 크기 (바이트 단위, 기본 32MB = 33554432)
MASK_MAX_BODY_BYTES=33554432


# ── 로깅 정책 ─────────────────────────────────────────────────────────────────
# Pino 로그 레벨: trace | debug | info | warn | error | fatal
MASK_LOG_LEVEL=info

# 페이로드 본문 로깅 의도 플래그 (true로 설정해도 아래 ALLOW 플래그 없이는 로깅되지 않음)
MASK_LOG_PAYLOADS=false

# 페이로드 로깅 실제 허용 스위치 (개발/디버깅 전용. 운영 중 true 절대 금지)
MASK_ALLOW_UNSAFE_LOGGING=false


# ── 업스트림 Provider API 키 ──────────────────────────────────────────────────
# providers.yaml 에서 api_key_env 로 지정한 환경변수 이름에 대응하는 실제 API 키입니다.
# (providers.yaml 에는 키 이름을 명시하고 실제 시크릿 값은 여기에만 둡니다)

# custom_llm API Key (providers.yaml의 active 또는 fallback이 custom_llm일 때 필요)
CUSTOM_LLM_KEY=
