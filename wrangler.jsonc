{
  // Cloudflare Static Assets worker for the web UI (xcv.kr/mask via gateway).
  // Worker name `mask` was created via dashboard Workers Builds (GitHub-based).
  // Assets-only: no main script. Routing/cache/security headers come from
  // web/dist/_redirects and web/dist/_headers, generated by
  // scripts/prepare-cloudflare.mjs from vercel.json (single source of truth).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mask",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "assets": {
    "directory": "./web/dist",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
